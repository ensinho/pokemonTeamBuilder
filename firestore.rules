rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['enzopo625@gmail.com'];
    }

    // Auth starts anonymous and upgrades via email link. Anything social
    // (public directory, friends, battles) requires a real, upgraded account —
    // otherwise the friend list fills with throwaway ghosts.
    function isUpgradedAccount() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Collection-group read for the forum badges: a trainer may count (list)
    // their OWN forum messages across every topic — the query must filter on
    // `createdBy == uid` or it is refused. Forum messages are world-readable
    // through their own path already; this exposes nothing new, and no other
    // collection in this database is named `messages`.
    match /{path=**}/messages/{messageId} {
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /artifacts/{appId} {

      match /users/{userId}/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /users/{userId}/profile/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Public trainer directory. Exists so trainers can find each other to add
      // as friends — it is deliberately world-readable and holds only what the
      // user already exposes on the forum (name + avatar), never their email.
      // Owned by the user; there is no server-side writer.
      match /publicProfiles/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId)
          && isUpgradedAccount()
          && validPublicProfile();
        allow delete: if isOwner(userId) || isAdmin();

        // NOTE: optional fields are read via `.get(key, default)`. Reading an
        // absent key off `request.resource.data` directly raises an error (which
        // denies the write), so `x == null ||` would *not* be a safe shorthand.
        // The trainer card's fields (2026-11-05): the streak as the check-in
        // keeps it, the persona from the onboarding, the month they joined.
        function validTrainerCard(d) {
          let streak = d.get('streak', null);
          let persona = d.get('persona', null);
          let memberSince = d.get('memberSince', null);
          return (streak == null || (streak is map
                && streak.keys().hasOnly(['count', 'lastVisit', 'shields'])
                && streak.get('count', 0) is int && streak.get('count', 0) >= 0 && streak.get('count', 0) <= 100000
                && (streak.get('lastVisit', null) == null || (streak.get('lastVisit', '') is string && streak.get('lastVisit', '').size() == 10))
                && streak.get('shields', 0) is int && streak.get('shields', 0) >= 0 && streak.get('shields', 0) <= 2))
            && (persona == null || persona in ['strategist', 'traveler', 'challenger', 'master'])
            && (memberSince == null || (memberSince is string && memberSince.size() <= 10));
        }

        function validPublicProfile() {
          let d = request.resource.data;
          let avatarId = d.get('avatarPokemonId', null);
          let sprite = d.get('trainerSprite', null);
          let badgeId = d.get('selectedBadgeId', null);
          // Rewards (2026-10-17): the equipped frame and title must be real
          // catalogue ids (constants/cosmetics.js — rewards.test.js fails when
          // these lists drift). Unlocks are judged on the client; a cosmetic
          // is low stakes, a made-up id rendering junk is not.
          let frameId = d.get('frameId', null);
          let titleId = d.get('titleId', null);
          let trainerLevel = d.get('trainerLevel', 1);
          let record = d.get('battleRecord', { 'wins': 0, 'losses': 0 });
          let priorRecord = resource == null
            ? { 'wins': 0, 'losses': 0 }
            : resource.data.get('battleRecord', { 'wins': 0, 'losses': 0 });
          return d.keys().hasOnly([
              'displayName', 'displayNameLower', 'avatarPokemonId',
              'avatarIsShiny', 'trainerSprite', 'selectedBadgeId', 'battleRecord', 'updatedAt',
              'frameId', 'titleId', 'trainerLevel',
              'streak', 'persona', 'memberSince'
            ])
            && d.displayName is string
            && d.displayName.size() >= 1 && d.displayName.size() <= 40
            // Mirrored lowercase copy backs prefix search; must match the name
            // so a user can't be findable under something they don't display.
            && d.displayNameLower is string
            && d.displayNameLower == d.displayName.lower()
            && (avatarId == null
                || (avatarId is int && avatarId > 0 && avatarId <= 1025))
            && d.get('avatarIsShiny', false) is bool
            && (sprite == null || (sprite is string && sprite.size() <= 40))
            && (badgeId == null || (badgeId is string && badgeId.size() <= 50))
            && (frameId == null || frameId in [
                'frame_poke', 'frame_grass', 'frame_fire', 'frame_water', 'frame_electric',
                'frame_great', 'frame_ice', 'frame_dragon', 'frame_ultra', 'frame_ghost',
                'frame_master', 'frame_daily', 'frame_shiny', 'frame_champion', 'frame_season'
              ])
            && (titleId == null || titleId in [
                'title_rising', 'title_loyal', 'title_explorer', 'title_builder', 'title_strategist',
                'title_social', 'title_challenger', 'title_ace', 'title_puzzle', 'title_quiz',
                'title_elite', 'title_veteran', 'title_legend', 'title_weekly', 'title_professor'
              ])
            && trainerLevel is int && trainerLevel >= 1 && trainerLevel <= 99
            // The trainer card (2026-11-05). Its own function: the rules
            // language allows 10 variables per function, and this one has 9.
            && validTrainerCard(d)
            && d.updatedAt is string
            // Win/loss is written by the battle resolver (admin SDK, which
            // bypasses these rules). A client may only ever leave it untouched,
            // so records can't be self-inflated.
            && record.keys().hasOnly(['wins', 'losses'])
            && record.get('wins', -1) is int && record.get('losses', -1) is int
            && record == priorRecord;
        }
      }

      // Friend requests. The doc id is `{fromUid}_{toUid}`, which makes a
      // duplicate request impossible by construction (same id → same doc) and
      // lets both parties address it without a query.
      match /friendRequests/{requestId} {
        allow read: if isSignedIn()
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);

        allow create: if isUpgradedAccount()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && requestId == request.resource.data.from + '_' + request.resource.data.to
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is string
          && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'respondedAt']);

        // Only the recipient answers a request, and only by moving it out of
        // 'pending' — nobody can rewrite who it was from or to.
        allow update: if isSignedIn()
          && request.auth.uid == resource.data.to
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt']);

        // Sender cancels, recipient dismisses. acceptRequest deletes both
        // directions defensively (only one usually exists) — deleting an
        // already-absent doc is a harmless no-op, so it must not error out on
        // a null `resource` and sink the whole batch.
        allow delete: if isSignedIn()
          && (resource == null
              || resource.data.to == request.auth.uid
              || resource.data.from == request.auth.uid);
      }

      // An accepted friendship. The doc id is the two uids sorted and joined,
      // so "are we friends?" is a single get() with no query, and the pair can
      // only ever exist once.
      match /friendships/{pairId} {
        allow read: if isSignedIn() && request.auth.uid in resource.data.members;

        // Created by whoever accepts the request. The pending request must
        // actually exist — otherwise anyone could befriend a stranger by
        // writing this doc directly.
        allow create: if isUpgradedAccount()
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          // Canonical ordering, which is what makes the id collision-free.
          && request.resource.data.members[0] < request.resource.data.members[1]
          && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
          && request.resource.data.createdAt is string
          && request.resource.data.keys().hasOnly(['members', 'createdAt'])
          && hasPendingRequestBetween(
              request.resource.data.members[0],
              request.resource.data.members[1]);

        // Immutable: to change a friendship you delete it and start over.
        allow update: if false;

        // Either side may unfriend.
        allow delete: if isSignedIn() && request.auth.uid in resource.data.members;

        function requestIsPending(from, to) {
          let path = /databases/$(database)/documents/artifacts/$(appId)/friendRequests/$(from + '_' + to);
          return exists(path) && get(path).data.status == 'pending';
        }

        // A request in either direction justifies the friendship.
        function hasPendingRequestBetween(a, b) {
          return requestIsPending(a, b) || requestIsPending(b, a);
        }
      }

      // Async ("play-by-message") battles between two friends.
      //
      // Clients own only the pre-battle lifecycle: create a challenge, accept or
      // decline it, submit a team. Everything that decides the *outcome* — seed,
      // turn, log, winner — is written by the serverless resolver through the
      // admin SDK, which bypasses these rules entirely. So there is deliberately
      // no client-writable path to any of those fields.
      match /battles/{battleId} {
        // Players always. Plus anyone signed in, for a **public invite** posted in
        // the forum: the card there has to show whether it is still open and who
        // took it. Nothing secret lives on this document — teams, logs and
        // choices are subcollections with their own owner-only rules — and the
        // seed is already visible to both players, so a spectator learning it
        // grants no power: only the two players can write a choice, and the
        // resolver is the only thing that decides an outcome.
        allow read: if isSignedIn()
          && (request.auth.uid in resource.data.players || isPublicInvite());

        allow create: if isUpgradedAccount()
          && request.resource.data.challenger == request.auth.uid
          && request.resource.data.players is list
          && request.auth.uid in request.resource.data.players
          && (directChallenge() || publicInvite())
          // The resolver's fields must start empty — a challenger can't seed a
          // battle in their own favour or pre-declare themselves the winner.
          // Read via `.get()`: an absent key raises an error rather than
          // returning null, which would deny the write for the wrong reason.
          && request.resource.data.get('seed', null) == null
          && request.resource.data.get('winner', null) == null
          && request.resource.data.get('turn', 0) == 0
          && request.resource.data.get('ready', {}).size() == 0
          // 'random' means the teams are dealt by /api/battle-random rather than
          // chosen. Absent is the ordinary battle, so old clients keep working.
          && request.resource.data.get('mode', 'standard') in ['standard', 'random']
          && request.resource.data.get('randomTeamsRolledAt', null) == null;

        // A challenge aimed at one person. Still friends-only: an unsolicited
        // battle from a stranger is a spam vector, which the public invite is
        // not — nobody receives one, people opt into it.
        function directChallenge() {
          return request.resource.data.players.size() == 2
            && request.resource.data.players[0] != request.resource.data.players[1]
            && request.resource.data.status == 'pending'
            && request.resource.data.get('isPublicInvite', false) == false
            && areFriends(request.resource.data.players[0], request.resource.data.players[1]);
        }

        // An open challenge to the forum: one player, no opponent yet, and the
        // first person to claim it becomes the second. No friendship needed —
        // that is the whole point of it.
        function publicInvite() {
          return request.resource.data.players.size() == 1
            && request.resource.data.players[0] == request.auth.uid
            && request.resource.data.status == 'open'
            && request.resource.data.get('isPublicInvite', false) == true;
        }

        function isPublicInvite() {
          return resource.data.get('isPublicInvite', false) == true;
        }

        allow update: if isSignedIn()
          && ((request.auth.uid in resource.data.players
                && (respondsToChallenge() || withdrawsChallenge() || submitsOwnReady() || startsBattle()))
              || claimsPublicInvite());

        // Only clutter is deletable; a battle that actually happened is a record.
        allow delete: if isSignedIn()
          && request.auth.uid in resource.data.players
          && resource.data.status in ['pending', 'open', 'declined', 'cancelled', 'ended', 'active', 'teamSelect'];

        function areFriends(a, b) {
          // Mirrors the canonical ordering used by /friendships.
          let id = a < b ? a + '_' + b : b + '_' + a;
          return exists(/databases/$(database)/documents/artifacts/$(appId)/friendships/$(id));
        }

        function touchesOnly(fields) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
        }

        // The challenged player accepts (→ team select) or declines.
        function respondsToChallenge() {
          return resource.data.status == 'pending'
            && request.auth.uid != resource.data.challenger
            && request.resource.data.status in ['teamSelect', 'declined']
            && touchesOnly(['status', 'lastActivityAt']);
        }

        // First come, first served. The compare-and-set is the whole contract:
        // the write is only allowed while the invite still has one player, so
        // two people racing to accept cannot both win — Firestore evaluates
        // this against the committed document, and the loser's update is
        // rejected rather than overwriting the winner.
        function claimsPublicInvite() {
          return isUpgradedAccount()
            && isPublicInvite()
            && resource.data.status == 'open'
            && resource.data.players.size() == 1
            && request.auth.uid != resource.data.challenger
            && request.resource.data.status == 'teamSelect'
            && request.resource.data.players.size() == 2
            && request.resource.data.players[0] == resource.data.players[0]
            && request.resource.data.players[1] == request.auth.uid
            && touchesOnly(['players', 'playerNames', 'playerAvatars', 'status', 'claimedAt', 'lastActivityAt']);
        }

        // The challenger takes it back while it's still unanswered — a direct
        // challenge nobody answered, or an open invite nobody claimed.
        function withdrawsChallenge() {
          return resource.data.status in ['pending', 'open']
            && request.auth.uid == resource.data.challenger
            && request.resource.data.status == 'cancelled'
            && touchesOnly(['status', 'lastActivityAt']);
        }

        // "My team is in." A player may only ever flip their *own* flag.
        function submitsOwnReady() {
          return resource.data.status == 'teamSelect'
            && request.resource.data.status == 'teamSelect'
            && touchesOnly(['ready', 'lastActivityAt'])
            && request.resource.data.ready.diff(resource.data.ready)
                .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.ready[request.auth.uid] == true;
        }

        // Either player may start it once both teams are in. The seed stays null:
        // it is the resolver's to set, so neither player can influence the RNG.
        function startsBattle() {
          return resource.data.status == 'teamSelect'
            && request.resource.data.status == 'active'
            && resource.data.ready.size() == 2
            && touchesOnly(['status', 'lastActivityAt']);
        }

        // A player's own team. Read-restricted to its owner so the opponent
        // cannot inspect their sets — the reason turn resolution is server-side
        // at all. Rules grant read per document, never per field, which is why
        // this can't be a map on the battle doc.
        match /teams/{teamOwnerId} {
          allow read: if isOwner(teamOwnerId);
          // Write-once: resubmitting after the battle starts would rewrite history.
          // `showdownText` is the team in Showdown import format — exactly what
          // buildShowdownExportText() emits (Level: 50 included) and what the
          // resolver feeds to Teams.import().
          //
          // In a random battle there is no client-submitted team at all: both
          // sides are dealt by /api/battle-random through the admin SDK. So no
          // client write is permitted, in either direction — otherwise a player
          // could create this document before the roll and be handed a battle
          // with the team they picked against an opponent who got six at random.
          allow create: if isOwner(teamOwnerId)
            && !isRandomBattle()
            && request.resource.data.showdownText is string
            && request.resource.data.showdownText.size() > 0
            && request.resource.data.showdownText.size() <= 20000;
          allow update: if isOwner(teamOwnerId)
            && !isRandomBattle()
            && battleDoc().status == 'teamSelect';
          allow delete: if false;

          function battleDoc() {
            return get(/databases/$(database)/documents/artifacts/$(appId)/battles/$(battleId)).data;
          }

          function isRandomBattle() {
            return battleDoc().get('mode', 'standard') == 'random';
          }
        }

        // Trainer talk. Same shape as a forum message.
        match /chat/{messageId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/battles/$(battleId)).data.players;
          allow create: if isSignedIn()
            && request.resource.data.createdBy == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/battles/$(battleId)).data.players
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 500;
          allow update: if false;
          allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
        }

        // The battle transcript, stored **per player**.
        //
        // It cannot be one shared document holding both sides: rules grant read
        // access per document and never per field, so a single doc with `p1` and
        // `p2` fields would let each player read the other's filtered stream —
        // undoing the entire reason turn resolution is server-side. Keyed by uid
        // and owner-read-only, exactly like /teams.
        //
        // Written only by the resolver (admin SDK): no client may forge a turn.
        match /playerLogs/{logOwnerId} {
          allow read: if isOwner(logOwnerId);
          allow write: if false;

          match /rounds/{roundId} {
            allow read: if isOwner(logOwnerId);
            allow write: if false;
          }
        }

        // A player's move/switch for a turn. Write-once so a choice can't be
        // changed after the fact; the resolver reads both and advances the turn.
        match /choices/{choiceId} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/battles/$(battleId)).data.players;
          allow create: if isSignedIn()
            && request.resource.data.uid == request.auth.uid
            && choiceId == string(get(/databases/$(database)/documents/artifacts/$(appId)/battles/$(battleId)).data.turn) + '_' + request.auth.uid
            && request.resource.data.choice is string;
          allow update, delete: if false;
        }
      }

      match /public/data/teams/{teamId} {
        allow read: if true;
        allow create: if isSignedIn() && validSharedTeam();
        allow update, delete: if isAdmin();

        function validSharedTeam() {
          return request.resource.data.name is string
            && request.resource.data.name.size() <= 100
            && request.resource.data.pokemons is list
            && request.resource.data.pokemons.size() <= 6;
        }
      }

      // Battle-text reactions (2026-11-06): `reactions` maps a uid to one of
      // four kinds; a trainer may set, change or clear only their own entry.
      function touchesOnlyOwnReaction() {
        let after = request.resource.data.get('reactions', {});
        let before = resource.data.get('reactions', {});
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in after) || after[request.auth.uid] in ['super', 'crit', 'weak', 'confused']);
      }

      // A report (2026-11-06): a trainer may only add themselves to
      // `reportedBy`, once, never remove anyone. Three hide the post until an
      // admin looks (the reasons go to /reports).
      function touchesOnlyOwnReport() {
        let after = request.resource.data.get('reportedBy', []);
        let before = resource.data.get('reportedBy', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          && !(request.auth.uid in before)
          && after.removeAll(before).hasOnly([request.auth.uid])
          && before.removeAll(after).size() == 0;
      }

      // The PokéPuzzle's day, together (2026-11-06): the distribution is
      // anyone's to read; a player's colour grid (never letters) is for
      // signed-in trainers — friends compare. Written by api/daily-puzzle.js.
      match /public/data/puzzleDays/{day} {
        allow read: if true;
        allow write: if false;
        match /players/{playerId} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      match /public/data/reports/{reportId} {
        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdBy', 'topicId', 'messageId', 'reason', 'createdAt'])
          && request.resource.data.reason in ['spam', 'rude', 'other']
          && request.resource.data.topicId is string && request.resource.data.topicId.size() <= 128;
        allow read, update, delete: if isAdmin();
      }

      match /public/data/forumTopics/{topicId} {
        allow read: if true;
        allow create: if isSignedIn()
          && (request.resource.data.createdBy == request.auth.uid || validDiaryTopic() || validWeeklyTopic());
        allow update: if isAdmin()
          || (isSignedIn() && resource.data.createdBy == request.auth.uid)
          || (isSignedIn() && onlyTouchesActivityFields())
          || (isSignedIn() && touchesOnlyOwnTopicLike())
          || (isSignedIn() && touchesOnlyOwnReaction())
          || (isSignedIn() && touchesOnlyOwnReport());

        // The Torneio da semana (2026-11-06, utils/forumWeekly.js): the first
        // trainer to need the week's topic creates it — id is the ISO week,
        // the theme one of the rotation's, the author the system.
        function validWeeklyTopic() {
          let d = request.resource.data;
          return topicId == 'weekly-' + d.weekKey
            && d.keys().hasOnly(['title', 'category', 'weekKey', 'theme', 'createdAt', 'createdBy', 'creatorName',
                'creatorAvatar', 'creatorAvatarIsShiny', 'lastActivityAt', 'messageCount', 'lastMessageText'])
            && d.category == 'teams'
            && d.createdBy == 'system'
            && d.weekKey is string && d.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
            && d.theme in ['kanto', 'monoFire', 'noLegends', 'gymLeader', 'unevolved', 'monoWater', 'starter', 'slow']
            && d.title is string && d.title.size() <= 40
            && d.messageCount == 0;
        }

        // The Diário do dia (2026-11-06, utils/forumDiary.js): the first
        // trainer to share on a day creates that day's topic. Its id is the
        // day, its author the system, and its date within a day of now — a
        // client can open today's room and nothing else.
        function validDiaryTopic() {
          let d = request.resource.data;
          let day = timestamp.date(int(d.dayKey[0:4]), int(d.dayKey[5:7]), int(d.dayKey[8:10]));
          return topicId == 'diary-' + d.dayKey
            && d.keys().hasOnly(['title', 'category', 'dayKey', 'createdAt', 'createdBy', 'creatorName',
                'creatorAvatar', 'creatorAvatarIsShiny', 'lastActivityAt', 'messageCount', 'lastMessageText'])
            && d.category == 'diary'
            && d.createdBy == 'system'
            && d.dayKey is string && d.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.title is string && d.title.size() <= 40
            && d.messageCount == 0
            && request.time > day - duration.value(2, 'd')
            && request.time < day + duration.value(2, 'd');
        }
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.createdBy == request.auth.uid);

        // Any signed-in user may bump the topic's activity metadata when they
        // post a reply, without being able to alter its title/category/owner.
        function onlyTouchesActivityFields() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastActivityAt', 'messageCount', 'lastMessageText']);
        }

        // The post's own vote (2026-10-17): any signed-in user may add or
        // remove only their own like on the topic, touching just the like
        // fields — the feed ranks and shows it without opening the thread.
        function touchesOnlyOwnTopicLike() {
          let affected = request.resource.data.diff(resource.data).affectedKeys();
          let willHave = request.resource.data.get('likedBy', []);
          let alreadyHas = resource.data.get('likedBy', []);
          let added = willHave.removeAll(alreadyHas);
          let removed = alreadyHas.removeAll(willHave);
          return affected.hasOnly(['likedBy', 'likeCount'])
            && added.hasOnly([request.auth.uid])
            && removed.hasOnly([request.auth.uid]);
        }

        match /messages/{messageId} {
          allow read: if true;
          allow create: if isSignedIn()
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if isAdmin()
            || (isSignedIn() && resource.data.createdBy == request.auth.uid)
            || (isSignedIn() && touchesOnlyOwnMessageLike())
            || (isSignedIn() && touchesOnlyOwnReaction())
            || (isSignedIn() && touchesOnlyOwnReport());
          allow delete: if isAdmin()
            || (isSignedIn() && resource.data.createdBy == request.auth.uid);

          // Any signed-in user may add/remove only their own like, touching just
          // the like fields — they cannot alter the message text or ownership.
          function touchesOnlyOwnMessageLike() {
            let affected = request.resource.data.diff(resource.data).affectedKeys();
            let willHave = request.resource.data.get('likedBy', []);
            let alreadyHas = resource.data.get('likedBy', []);
            let added = willHave.removeAll(alreadyHas);
            let removed = alreadyHas.removeAll(willHave);
            return affected.hasOnly(['likedBy', 'likeCount'])
              && added.hasOnly([request.auth.uid])
              && removed.hasOnly([request.auth.uid]);
          }
        }
      }

      match /feedback/likes {
        allow read: if true;
        allow create, update: if isSignedIn() && touchesOnlyOwnLike();
        allow delete: if isAdmin();

        function touchesOnlyOwnLike() {
          let willHave = request.resource.data.get('userIds', []);
          let alreadyHas = resource == null ? [] : resource.data.get('userIds', []);
          let added = willHave.removeAll(alreadyHas);
          let removed = alreadyHas.removeAll(willHave);
          return added.hasOnly([request.auth.uid])
            && removed.hasOnly([request.auth.uid]);
        }
      }

      match /feedback/{docId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isAdmin();
      }

      match /suggestions/{docId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isAdmin();
      }

      match /pokemons/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // ── Champion Challenge (api/challenge.js is the only writer) ──────────
      // Runs live OUTSIDE users/{uid}/: the wildcard there grants the owner
      // full write, and rules only ever add permissions, so a run stored there
      // could be marked "won" from the console. Here the owner may read and
      // delete (account deletion) — never create or update.

      // The day's public document: lineup without sets, the Time do dia.
      match /public/data/challengeDays/{dayKey} {
        allow read: if true;
        allow write: if false;
      }

      // The day's ranking (ranking.js): written only by the server, inside the
      // transaction that ends an official run — a place can't be claimed here.
      match /public/data/challengeRanks/{dayKey} {
        allow read: if true;
        allow write: if false;
      }

      match /challengeRuns/{runId} {
        allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create, update: if false;

        // The player's own view of the log, one document per action.
        match /rounds/{seq} {
          allow read, delete: if isSignedIn()
            && get(/databases/$(database)/documents/artifacts/$(appId)/challengeRuns/$(runId)).data.uid == request.auth.uid;
          allow create, update: if false;
        }

        // Seed, choices, both teams and the AI trace: with these the RNG and
        // Cynthia's sets are an open book, so nobody reads them. The owner may
        // delete (account deletion removes this before the run itself, since
        // the rule reads the parent).
        match /secret/{docId} {
          allow read, create, update: if false;
          allow delete: if isSignedIn()
            && get(/databases/$(database)/documents/artifacts/$(appId)/challengeRuns/$(runId)).data.uid == request.auth.uid;
        }
      }

      match /challengeStats/{userId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }

      // Anonymous battle rows for the AI's models: no uid, so nobody's to read.
      match /aiTraining/{docId} {
        allow read, write: if false;
      }
    }
  }
}
