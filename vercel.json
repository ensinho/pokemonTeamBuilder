{
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "crons": [
    {
      "path": "/api/refresh-tournaments",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/daily-puzzle",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/render-meta.js": {
      "includeFiles": "dist/**"
    },
    "api/battle-turn.js": {
      "memory": 2048,
      "maxDuration": 30,
      "excludeFiles": "api/**/*.test.js"
    },
    "api/battle-random.js": {
      "memory": 2048,
      "maxDuration": 30,
      "excludeFiles": "api/**/*.test.js"
    },
    "api/battle-notify.js": {
      "maxDuration": 15,
      "excludeFiles": "api/**/*.test.js"
    },
    "api/daily-puzzle.js": {
      "maxDuration": 60,
      "excludeFiles": "api/**/*.test.js"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)\\.(png|jpg|jpeg|svg|ico|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/api/render-meta"
    }
  ]
}
