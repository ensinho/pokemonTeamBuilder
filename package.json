{
  "name": "pokemonteambuilder",
  "homepage": "https://ensinho.github.io/pokemonTeamBuilder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "data:cache": "node scripts/build-pokemon-cache.mjs",
    "data:cache:details": "node scripts/build-pokemon-cache.mjs --details=1-151",
    "data:tournaments": "node scripts/build-tournaments.mjs",
    "data:smogon": "node scripts/build-smogon.mjs",
    "data:moves": "node scripts/build-move-types.mjs",
    "data:usage": "node scripts/build-usage-stats.mjs",
    "data:limitless": "node scripts/build-limitless-usage.mjs",
    "data:sitemap": "node scripts/build-sitemap.mjs",
    "data:trainers": "node scripts/build-trainer-sprites.mjs",
    "prebuild": "node scripts/build-tournaments.mjs && node scripts/build-smogon.mjs && node scripts/build-move-types.mjs && node scripts/build-usage-stats.mjs && node scripts/build-limitless-usage.mjs && node scripts/build-trainer-sprites.mjs && node scripts/build-sitemap.mjs",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky"
  },
  "//overrides": "jwks-rsa (via firebase-admin) is CommonJS but declares jose@^6, which is ESM-only — its require('jose') dies with ERR_REQUIRE_ESM on any runtime without require(esm), which is how Vercel loads functions. jose@5 ships a CJS build and has every API jwks-rsa uses. Do not remove without running api/lib/dependencies.test.js; see docs/wounds.md 2026-07-27.",
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  },
  "dependencies": {
    "@pkmn/img": "^0.3.4",
    "@pkmn/randoms": "0.10.11",
    "@pkmn/sim": "0.10.11",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.2.0",
    "gh-pages": "^6.3.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.17.0",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.10.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "gh-pages": "^6.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
